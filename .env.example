# Public URL of the deployed site. Set this once a real domain points here,
# e.g. https://orohouse.com — share cards and canonical links use it.
# On Vercel this is inferred automatically if you leave it unset.
NEXT_PUBLIC_SITE_URL=

# Where the booking form POSTs its JSON. A form service, a webhook, or your
# own route handler. If unset, the form falls back to the guest's mail client.
NEXT_PUBLIC_BOOKING_ENDPOINT=
